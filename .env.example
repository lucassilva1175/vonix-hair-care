# Copie para .env (local) ou cadastre como segredos no Lovable (Settings > Secrets). Nunca comite valores reais.

# Appmax — credenciais do lojista (Appmax > Integrações > API)
APPMAX_ENV=sandbox                # sandbox | production
APPMAX_CLIENT_ID=
APPMAX_CLIENT_SECRET=
APPMAX_EXTERNAL_ID=               # necessário para pagamento com cartão (Appmax JS)

# Melhor Envio — token de acesso com permissão de cálculo de frete
MELHORENVIO_ENV=sandbox           # sandbox | production
MELHORENVIO_TOKEN=
MELHORENVIO_CONTACT_EMAIL=contato@vonixhaircosmeticos.com.br
STORE_ORIGIN_CEP=                 # CEP de onde a Vonix despacha, só números

# Bling v3 (ERP) — app em Bling > Preferências > Área do desenvolvedor; refresh token vem da 1ª autorização OAuth
BLING_CLIENT_ID=
BLING_CLIENT_SECRET=
BLING_REFRESH_TOKEN=

# Medidas por unidade (ajuste com os valores reais das embalagens)
MELHORENVIO_UNIT_WEIGHT_KG=0.6
MELHORENVIO_PKG_WIDTH_CM=16
MELHORENVIO_PKG_HEIGHT_CM=12
MELHORENVIO_PKG_LENGTH_CM=22
