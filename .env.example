# Copie para .env (local) ou cadastre como segredos no Lovable (Settings > Secrets). Nunca comite valores reais.

# Appmax — credenciais do lojista (Appmax > Integrações > API)
APPMAX_ENV=sandbox                # sandbox | production
APPMAX_CLIENT_ID=
APPMAX_CLIENT_SECRET=
APPMAX_EXTERNAL_ID=               # necessário para pagamento com cartão (Appmax JS)

# Melhor Envio — token de acesso com permissão de cálculo de frete
MELHORENVIO_ENV=sandbox           # sandbox | production
MELHORENVIO_TOKEN=
MELHORENVIO_CONTACT_EMAIL=contato@vonixhaircosmeticos.com.br
STORE_ORIGIN_CEP=                 # CEP de onde a Vonix despacha, só números

# Etiqueta automática do Melhor Envio (gasta saldo real da conta; deixe false até testar em sandbox)
# Precisa também de SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY e da tabela de supabase/envios.sql.
# O token do Melhor Envio precisa das permissões: shipping-calculate, cart-write, shipping-checkout, shipping-generate, shipping-tracking.
MELHORENVIO_AUTO_LABEL=false
STORE_ORIGIN_NAME=                # nome/razão social do remetente
STORE_ORIGIN_DOCUMENT=            # CPF ou CNPJ do remetente, só números
STORE_ORIGIN_EMAIL=
STORE_ORIGIN_PHONE=
STORE_ORIGIN_STREET=
STORE_ORIGIN_NUMBER=
STORE_ORIGIN_COMPLEMENT=
STORE_ORIGIN_DISTRICT=
STORE_ORIGIN_CITY=
STORE_ORIGIN_STATE=               # UF, ex.: MG

# Bling v3 (ERP) — app em Bling > Preferências > Área do desenvolvedor; refresh token vem da 1ª autorização OAuth
BLING_CLIENT_ID=
BLING_CLIENT_SECRET=
BLING_REFRESH_TOKEN=
BLING_LOJA_ID=                    # id da loja 'Site Vonix Hair' no Bling; identifica a origem do pedido

# Medidas por unidade (ajuste com os valores reais das embalagens)
MELHORENVIO_UNIT_WEIGHT_KG=0.6
MELHORENVIO_PKG_WIDTH_CM=16
MELHORENVIO_PKG_HEIGHT_CM=12
MELHORENVIO_PKG_LENGTH_CM=22

# Painel interno /painel (pedidos de todos os canais). Defina uma senha forte.
PANEL_PASSWORD=
